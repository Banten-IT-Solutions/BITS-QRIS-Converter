{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bits-qris-converter",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "qris.bits.co.id/*",
      "zone_name": "bits.co.id"
    }
  ],
  "vars": {
    "WORKER_NAME": "bits-qris-converter",
    "CUSTOM_DOMAIN": "qris.bits.co.id"
  },
  "observability": {
    "enabled": true
  }
}
